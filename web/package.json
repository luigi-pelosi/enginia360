{
  "name": "enginia360-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:ui01": "tsc --noEmit && vite build --config vite.ui01.config.ts",
    "build:ui01-runtime": "tsc --noEmit && vite build --config vite.ui01-runtime.config.ts",
    "dev:ui01": "vite --config vite.ui01.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "antd": "6.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
