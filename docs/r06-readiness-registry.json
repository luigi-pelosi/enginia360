  "requirements": [
    {
      "id": "OPE01",
      "remit": "Dominio e spesa, proprietario",
      "condition": "Prima di qualsiasi acquisto: nome/estensione/registrar, prezzo iniziale e rinnovo, IVA/extra e autorizzazione esplicita; controllo DNS prima dell'accesso pubblico tramite dominio"
    },
    {
      "id": "OPE02",
      "remit": "Identity, responsabile tecnico e proprietario",
      "condition": "B00 e scope prima di implementare B01; risorse, trasporto protetto, protocolli/MFA, revoca, recupero e manutenzione verificati prima di completare B01; nessun login reale sul bootstrap HTTP anonimo"
    },
    {
      "id": "OPE03",
      "remit": "Backup, responsabile da assegnare dal proprietario",
      "condition": "Destinazione, quote, cifratura/chiavi, checkpoint giornaliero, retention e guasti da definire prima dell'uso dello stato persistente della demo; ripristino end-to-end misurato prima di completare B14 e prima del pilota con dati reali"
    },
    {
      "id": "OPE04",
      "remit": "Allarmi/manutenzione, proprietario assegna i ruoli residui",
      "condition": "Prima della messa in servizio: fuso/festività/fine fascia, estremi RTO, canali SMTP e ricezione verificata; assegnare controllo backup, patch host/container e amministrazione identity senza estendere implicitamente D50"
    },
    {
      "id": "OPE05",
      "remit": "Target e costi pilota, proprietario",
      "condition": "Prima del pilota: paese/contratti del target e destinazioni dati pertinenti, quote/costi effettivi e capacità, risorse di recupero e test; nessuna deroga UE dedotta da D54"
    }
  ],
